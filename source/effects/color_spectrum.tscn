[sub_resource type="Shader" id="Shader_njf0n"]
code = "shader_type canvas_item;


uniform float wave_amplitude = 10.;
uniform float wave_time = 0.;
uniform float wave_offset = 0.;
uniform float wave_frequency = 5.;
uniform float wave_buffer = -.2;
uniform float wave_extents = 60;

uniform sampler2D gradient : filter_nearest, repeat_disable;

float remap(float value, float in_min, float in_max, float out_min, float out_max) {
    return out_min + (value - in_min) * (out_max - out_min) / (in_max - in_min);
}

void vertex() {
	float t = TIME;
	float x = VERTEX.x;
	
	float gradient_position = remap(
		abs(x),0,wave_extents,0,1
	);
	
	COLOR *= texture(gradient,vec2(gradient_position,0.));
	
	x += wave_extents;
	
	VERTEX.y += (1./60.)*wave_amplitude*cos(
		(t + x*wave_buffer + wave_offset*PI)*wave_frequency
	);
}


//void light() {
//	// Called for every pixel for every light affecting the CanvasItem.
//	// Uncomment to replace the default light processing function with this one.
//}
"

